{
  "name": "biblioteca-lectura",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generar-seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 504",
    "esquema": "node scripts/volcar-esquema.mjs",
    "humo": "node scripts/humo.mjs",
    "respaldo": "node scripts/respaldar.mjs",
    "security-check": "npm run lint && node scripts/scan-secrets.mjs && npm audit --audit-level=high",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "dependencies": {
    "@sentry/browser": "^10.75.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "posthog-js": "^1.422.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
