# Copia este archivo como .env.local y rellena los valores reales.
# Obtén estas claves en: https://supabase.com → tu proyecto → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# PostHog (analítica de producto) — https://eu.posthog.com → Settings → Project
# Sin VITE_POSTHOG_KEY la analítica queda apagada y la app funciona igual.
# El host debe ser el de la UE: la CSP de vercel.json solo autoriza eu.i.posthog.com.
VITE_POSTHOG_KEY=phc_tu-project-api-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (errores en producción) — https://sentry.io → Project → Client Keys
# Sin VITE_SENTRY_DSN el reporte queda apagado y la app funciona igual.
# La CSP de vercel.json ya autoriza los ingest de la UE y de EE. UU.
VITE_SENTRY_DSN=https://tu-clave@o000000.ingest.de.sentry.io/0000000
