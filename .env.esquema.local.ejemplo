# Copia este archivo a .env.esquema.local y pon tus datos.
# .gitignore ya cubre `.env.*.local`, así que nunca se sube al repo.
# Es solo para volcar la estructura de la base (npm run esquema).
#
# La cadena sale de Supabase → botón «Connect» (arriba) → Session pooler.
# Cambia [YOUR-PASSWORD] por la contraseña de la base de datos (no la de tu
# cuenta de Supabase). Si no la recuerdas: Settings → Database → Reset password.
SUPABASE_DB_URL=postgresql://postgres.TU-REF:TU-CLAVE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Opcional: carpeta de pg_dump/psql si no están en el PATH ni en C:\Program Files\PostgreSQL\<versión>\bin
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
